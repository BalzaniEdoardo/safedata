{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/style/check.py\" --hook",
            "timeout": 10,
            "statusMessage": "Checking writing rules"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/style/check.py\" --stop-hook",
            "timeout": 30,
            "statusMessage": "Checking writing rules in changed files"
          }
        ]
      }
    ]
  }
}
